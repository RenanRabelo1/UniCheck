NODE_ENV=development
PORT=3000

# Origens autorizadas a chamar a API (separe por vírgula). Padrão: front em Vite.
CORS_ORIGIN=http://localhost:5173


# Obrigatório em produção. Use um segredo local forte fora do versionamento.
JWT_SECRET=defina_uma_chave_longa_e_aleatoria

# MySQL local (8.0.16 ou superior). Cada membro usa o seu próprio banco.
# O banco é criado pelo "npm run migrate" se ainda não existir.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha_do_mysql
DB_NAME=unicheck
